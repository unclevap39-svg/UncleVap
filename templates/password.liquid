<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Bientôt disponible</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;600&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="template-password">
  <div class="password-page">
    <h1 class="password-title">{{ shop.name }}</h1>
    <p class="password-subtitle">Bientôt disponible — La galaxie CBD arrive.</p>
    {{ content_for_layout }}
  </div>
  <style>
  .password-page {
    min-height: 100vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    background: #050e05; color: #fff;
    text-align: center; padding: 40px 16px; gap: 20px;
  }
  .password-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(40px, 10vw, 80px);
    color: #f5d97a; letter-spacing: 3px;
  }
  .password-subtitle {
    font-family: 'Oswald', sans-serif;
    color: #a8c8a8; font-size: 18px;
  }
  </style>
</body>
</html>
