<section class="stats-counter" id="stats-counter-{{ section.id }}">
  <!-- Particules décoratives -->
  <div class="stats-particles" aria-hidden="true">
    <span class="stats-particle stats-particle--1"></span>
    <span class="stats-particle stats-particle--2"></span>
    <span class="stats-particle stats-particle--3"></span>
    <span class="stats-particle stats-particle--4"></span>
  </div>

  <div class="stats-inner">
    <div class="stats-grid">

      <div class="stat-item" data-target="10000" data-suffix="+">
        <div class="stat-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
            <circle cx="18" cy="16" r="7" stroke="#2ea82e" stroke-width="2" fill="rgba(46,168,46,0.1)"/>
            <circle cx="30" cy="16" r="7" stroke="#3dbe3d" stroke-width="2" fill="rgba(46,168,46,0.1)"/>
            <path d="M6 36 C6 28 12 24 18 24 C24 24 30 28 30 28 C30 28 36 24 42 28 C42 28 42 32 42 36" stroke="#2ea82e" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <span class="stat-number" data-count="10000" data-suffix="+">0+</span>
        <span class="stat-label">{{ section.settings.stat1_label | default: 'Clients satisfaits' }}</span>
      </div>

      <div class="stat-item" data-target="500" data-suffix="+">
        <div class="stat-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
            <rect x="10" y="8" width="12" height="32" rx="3" fill="rgba(46,168,46,0.15)" stroke="#2ea82e" stroke-width="2"/>
            <rect x="13" y="11" width="6" height="5" rx="1" fill="rgba(255,255,255,0.15)"/>
            <circle cx="34" cy="20" rx="8" r="8" fill="rgba(61,190,61,0.15)" stroke="#3dbe3d" stroke-width="2"/>
            <path d="M30 20 L34 24 L40 16" stroke="#3dbe3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="stat-number" data-count="500" data-suffix="+">0+</span>
        <span class="stat-label">{{ section.settings.stat2_label | default: 'Références CBD' }}</span>
      </div>

      <div class="stat-item" data-target="49" data-suffix="/5">
        <div class="stat-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
            <path d="M24 6 L28.5 17 L40 17.5 L31 25 L33.8 37 L24 31 L14.2 37 L17 25 L8 17.5 L19.5 17 Z" fill="#f5c518" opacity="0.9" stroke="#d4a017" stroke-width="1"/>
          </svg>
        </div>
        <span class="stat-number stat-number--decimal" data-count="49" data-suffix="/5" data-decimal="true">0/5</span>
        <span class="stat-label">{{ section.settings.stat3_label | default: 'Note moyenne' }}</span>
      </div>

      <div class="stat-item" data-target="48" data-suffix="h">
        <div class="stat-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
            <circle cx="24" cy="24" r="16" stroke="#2ea82e" stroke-width="2" fill="rgba(46,168,46,0.1)"/>
            <line x1="24" y1="12" x2="24" y2="24" stroke="#2ea82e" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="24" y1="24" x2="32" y2="30" stroke="#3dbe3d" stroke-width="2" stroke-linecap="round"/>
            <circle cx="24" cy="24" r="2" fill="#2ea82e"/>
          </svg>
        </div>
        <span class="stat-number" data-count="48" data-suffix="h">0h</span>
        <span class="stat-label">{{ section.settings.stat4_label | default: 'Livraison express' }}</span>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compteur de confiance",
  "class": "section-stats-counter",
  "settings": [
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Libellé stat 1",
      "default": "Clients satisfaits"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Libellé stat 2",
      "default": "Références CBD"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Libellé stat 3",
      "default": "Note moyenne"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Libellé stat 4",
      "default": "Livraison express"
    }
  ],
  "presets": [
    { "name": "Compteur de confiance" }
  ]
}
{% endschema %}
