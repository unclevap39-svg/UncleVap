{%- assign overlay = section.settings.overlay_opacity | divided_by: 100.0 -%}
<section class="hero-banner{% if section.settings.hero_bg_image != blank %} hero-banner--has-bg-image{% endif %}" aria-label="Hero banner">

  {%- if section.settings.hero_bg_image != blank -%}
    <!-- Responsive background image (picture pour mobile/desktop séparés) -->
    <picture>
      {%- if section.settings.hero_bg_image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ section.settings.hero_bg_image_mobile | image_url: width: 480 }} 480w,
            {{ section.settings.hero_bg_image_mobile | image_url: width: 750 }} 750w,
            {{ section.settings.hero_bg_image_mobile | image_url: width: 960 }} 960w
          "
          sizes="100vw"
        >
      {%- endif -%}
      <img
        class="hero-bg-img{% if section.settings.hero_bg_image_mobile == blank %} hero-bg-img--mobile-focal-{{ section.settings.mobile_focal | default: 'center' }}{% endif %}"
        src="{{ section.settings.hero_bg_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.hero_bg_image | image_url: width: 750 }} 750w,
          {{ section.settings.hero_bg_image | image_url: width: 1024 }} 1024w,
          {{ section.settings.hero_bg_image | image_url: width: 1440 }} 1440w,
          {{ section.settings.hero_bg_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="640"
      >
    </picture>
    <div class="hero-bg-overlay" style="--hero-overlay: {{ overlay }};"></div>
  {%- else -%}
    <!-- Cosmic background particles -->
    <div class="hero-bg" aria-hidden="true">
      <div class="cosmic-glow cosmic-glow--left"></div>
      <div class="cosmic-glow cosmic-glow--right"></div>
      <!-- Floating leaves -->
      <svg class="leaf leaf-1" viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 2C20 2 6 12 4 26C2 40 14 48 20 48C26 48 38 40 36 26C34 12 20 2 20 2Z" fill="#2ea82e" opacity="0.7"/>
        <path d="M20 2 L20 48" stroke="#1d7a1d" stroke-width="1.5" opacity="0.8"/>
        <path d="M20 15 L10 28 M20 20 L12 35 M20 25 L13 38 M20 15 L30 28 M20 20 L28 35 M20 25 L27 38" stroke="#1d7a1d" stroke-width="1" opacity="0.6"/>
      </svg>
      <svg class="leaf leaf-2" viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 2C20 2 6 12 4 26C2 40 14 48 20 48C26 48 38 40 36 26C34 12 20 2 20 2Z" fill="#2ea82e" opacity="0.5"/>
        <path d="M20 2 L20 48" stroke="#1d7a1d" stroke-width="1.5" opacity="0.6"/>
      </svg>
      <svg class="leaf leaf-3" viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 2C20 2 6 12 4 26C2 40 14 48 20 48C26 48 38 40 36 26C34 12 20 2 20 2Z" fill="#3dbe3d" opacity="0.4"/>
        <path d="M20 2 L20 48" stroke="#2ea82e" stroke-width="1.5" opacity="0.5"/>
      </svg>
      <svg class="leaf leaf-4" viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 2C20 2 6 12 4 26C2 40 14 48 20 48C26 48 38 40 36 26C34 12 20 2 20 2Z" fill="#2ea82e" opacity="0.6"/>
        <path d="M20 2 L20 48" stroke="#1d7a1d" stroke-width="1.5" opacity="0.7"/>
      </svg>
      <!-- Sparkle stars -->
      <div class="star star-1" aria-hidden="true"></div>
      <div class="star star-2" aria-hidden="true"></div>
      <div class="star star-3" aria-hidden="true"></div>
      <div class="star star-4" aria-hidden="true"></div>
      <div class="star star-5" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  <div class="hero-inner">
    {%- unless section.settings.hero_bg_image != blank -%}
    <!-- Character image (hidden when bg image is used — character is already in the bg) -->
    <div class="hero-character">
      {%- if section.settings.character_image != blank -%}
        <img
          src="{{ section.settings.character_image | image_url: width: 700 }}"
          alt="Uncle Vap"
          class="hero-character-img"
          width="600"
          height="700"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <!-- Placeholder character silhouette -->
        <div class="hero-character-placeholder" aria-label="Personnage Uncle Vap">
          <div class="character-glow-ring"></div>
        </div>
      {%- endif -%}
      <div class="hero-brand-text" aria-hidden="true">Uncle Vap</div>
    </div>
    {%- endunless -%}

    <!-- Hero content (right on desktop, bottom on mobile) -->
    <div class="hero-content">
      <h1 class="hero-title">
        {{ section.settings.title | default: 'VOTRE ESCALE VERS LA<br>RELAXATION COSMIQUE' }}
      </h1>
      <p class="hero-subtitle">
        {{ section.settings.subtitle | default: "Uncle Vap vous guide à travers notre collection de fleurs, vapes et cafés d'une autre dimension." }}
      </p>
      <a href="{{ section.settings.cta_link | default: routes.collections_url }}" class="btn-hero-cta">
        {{ section.settings.cta_text | default: 'DÉCOUVRIR LA GALAXIE CBD' }}
      </a>
      <p class="hero-reassurance">✓ Livraison 24-48h&nbsp;&nbsp;&nbsp;✓ Paiement sécurisé&nbsp;&nbsp;&nbsp;✓ Lab certifié</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Images de fond"
    },
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Image de fond — Desktop",
      "info": "Format paysage recommandé (ex : 1920×1080)"
    },
    {
      "type": "image_picker",
      "id": "hero_bg_image_mobile",
      "label": "Image de fond — Mobile (optionnel)",
      "info": "Format portrait recommandé (ex : 750×1200). Si absent, l'image desktop est utilisée avec recadrage."
    },
    {
      "type": "select",
      "id": "mobile_focal",
      "label": "Recadrage mobile (si pas d'image mobile)",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left",   "label": "Gauche" },
        { "value": "right",  "label": "Droite" },
        { "value": "top",    "label": "Haut" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "character_image",
      "label": "Image du personnage (sans image de fond uniquement)"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre principal",
      "default": "<p>VOTRE ESCALE VERS LA RELAXATION COSMIQUE</p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Uncle Vap vous guide à travers notre collection de fleurs, vapes et cafés d'une autre dimension."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton CTA",
      "default": "DÉCOUVRIR LA GALAXIE CBD"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton CTA"
    },
    {
      "type": "header",
      "content": "Overlay de l'image de fond"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacité de l'overlay sombre",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
