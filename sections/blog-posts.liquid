{%- liquid
  assign title        = section.settings.title
  assign subtitle     = section.settings.subtitle
  assign blog         = blogs[section.settings.blog]
  assign posts_count  = section.settings.posts_count
  assign show_date    = section.settings.show_date
  assign show_excerpt = section.settings.show_excerpt
  assign show_all     = section.settings.show_all_link
-%}

<section class="blog-posts" id="blog-posts-{{ section.id }}">
  <div class="blog-posts-inner">
    {%- if title != blank or subtitle != blank -%}
      <div class="section-header">
        {%- if title != blank -%}
          <h2 class="section-title">{{ title }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="section-subtitle">{{ subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="blog-posts-grid">
        {%- for article in blog.articles limit: posts_count -%}
          <article class="blog-card">
            <a class="blog-card-img-wrap" href="{{ article.url }}">
              {%- if article.image != blank -%}
                <img
                  class="blog-card-img"
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="340"
                >
              {%- else -%}
                <div class="blog-card-img-placeholder">
                  <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M30 5C16 5 5 16 5 30C5 44 16 55 30 55C44 55 55 44 55 30C55 16 44 5 30 5Z" stroke="#2ea82e" stroke-width="1.5" fill="none"/>
                    <path d="M30 15C30 15 22 22 22 30C22 38 30 45 30 45C30 45 38 38 38 30C38 22 30 15 30 15Z" fill="#2ea82e" opacity="0.6"/>
                  </svg>
                </div>
              {%- endif -%}
            </a>

            <div class="blog-card-body">
              {%- if show_date -%}
                <time class="blog-card-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%d %B %Y' }}
                </time>
              {%- endif -%}
              <h3 class="blog-card-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              {%- if show_excerpt and article.excerpt != blank -%}
                <p class="blog-card-excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <a class="blog-card-link" href="{{ article.url }}">Lire la suite →</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if show_all and blog.articles.size > posts_count -%}
        <div class="blog-posts-footer">
          <a class="btn btn--outline" href="{{ blog.url }}">Voir tous les articles</a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment %} Placeholder affiché si aucun blog n'est sélectionné {%- endcomment %}
      <div class="blog-posts-grid">
        {%- for i in (1..3) -%}
          <article class="blog-card blog-card--placeholder">
            <div class="blog-card-img-wrap blog-card-img-wrap--placeholder">
              <div class="blog-card-img-placeholder">
                <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M30 5C16 5 5 16 5 30C5 44 16 55 30 55C44 55 55 44 55 30C55 16 44 5 30 5Z" stroke="#2ea82e" stroke-width="1.5" fill="none"/>
                  <path d="M30 15C30 15 22 22 22 30C22 38 30 45 30 45C30 45 38 38 38 30C38 22 30 15 30 15Z" fill="#2ea82e" opacity="0.6"/>
                </svg>
              </div>
            </div>
            <div class="blog-card-body">
              <time class="blog-card-date">{{ 'now' | date: '%d %B %Y' }}</time>
              <h3 class="blog-card-title"><a href="#">Votre prochain article CBD</a></h3>
              <p class="blog-card-excerpt">Partagez votre expertise avec votre communauté. Sélectionnez votre blog dans l'éditeur de thème.</p>
              <a class="blog-card-link" href="#">Lire la suite →</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Articles de Blog",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "LA GAZETTE COSMIQUE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Conseils, actus et guides sur le monde du CBD."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog à afficher"
    },
    {
      "type": "range",
      "id": "posts_count",
      "label": "Nombre d'articles",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Afficher la date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Afficher l'extrait",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_all_link",
      "label": "Afficher le lien « Voir tous les articles »",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Articles de Blog"
    }
  ]
}
{% endschema %}
