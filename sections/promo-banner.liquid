{%- liquid
  assign heading   = section.settings.heading
  assign subheading = section.settings.subheading
  assign btn_text  = section.settings.button_text
  assign btn_link  = section.settings.button_link
  assign bg_image  = section.settings.background_image
  assign overlay   = section.settings.overlay_opacity | divided_by: 100.0
  assign alignment = section.settings.text_alignment
-%}

<section
  class="promo-banner promo-banner--align-{{ alignment }}"
  id="promo-{{ section.id }}"
  style="--overlay-opacity: {{ overlay }};"
>
  {%- if bg_image != blank -%}
    <img
      class="promo-bg-img"
      src="{{ bg_image | image_url: width: 1600 }}"
      alt=""
      loading="lazy"
      width="1600"
      height="600"
    >
  {%- else -%}
    <div class="promo-bg-fallback"></div>
  {%- endif -%}

  <div class="promo-overlay"></div>

  <div class="promo-inner">
    <div class="promo-content">
      {%- if heading != blank -%}
        <h2 class="promo-heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="promo-sub">{{ subheading }}</p>
      {%- endif -%}
      {%- if btn_text != blank -%}
        <a class="btn btn--promo" href="{{ btn_link | default: '#' }}">{{ btn_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière Promotionnelle",
  "class": "section-promo-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "UNE NOUVELLE DIMENSION DU CBD"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Découvrez notre sélection de fleurs premium, extraits et vapes d'une qualité cosmique."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "EXPLORER LA COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacité de l'overlay",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 55,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignement du texte",
      "options": [
        { "value": "left",   "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right",  "label": "Droite" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Bannière Promotionnelle"
    }
  ]
}
{% endschema %}
