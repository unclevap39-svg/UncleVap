<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">

    <!-- Footer logo -->
    {%- assign footer_logo_w = section.settings.logo_size | default: 100 -%}
    <div class="footer-brand">
      {%- if section.settings.footer_logo != blank -%}
        <a href="{{ routes.root_url }}" class="footer-logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ section.settings.footer_logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ footer_logo_w }}"
            height="{{ footer_logo_w }}"
            style="width: {{ footer_logo_w }}px; height: auto; max-height: {{ footer_logo_w }}px;"
            loading="lazy"
          >
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="footer-logo-link footer-logo-placeholder" aria-label="{{ shop.name }}">
          <span class="footer-logo-text">{{ shop.name }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Footer nav -->
    <nav class="footer-nav" aria-label="Navigation pied de page">
      {%- for link in linklists[section.settings.footer_menu].links -%}
        <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | upcase }}</a>
      {%- endfor -%}
    </nav>

    <!-- Social / tagline -->
    <div class="footer-social">
      <p class="footer-tagline">{{ section.settings.tagline | default: "On se retrouve dans l'espace ! 🚀" }}</p>
      <div class="footer-social-links">
        {%- if section.settings.instagram_handle != blank -%}
          <a
            href="https://instagram.com/{{ section.settings.instagram_handle }}"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span>{{ section.settings.instagram_handle }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.website_url != blank -%}
          <a
            href="{{ section.settings.website_url }}"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Site web"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span>{{ section.settings.website_display | default: section.settings.website_url }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="footer-bottom">
    <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo du footer"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Taille du logo",
      "min": 40,
      "max": 200,
      "step": 4,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menu footer",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Accroche sociale",
      "default": "On se retrouve dans l'espace !"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Pseudo Instagram (sans @)",
      "default": "unclevap_cbd"
    },
    {
      "type": "url",
      "id": "website_url",
      "label": "URL du site web"
    },
    {
      "type": "text",
      "id": "website_display",
      "label": "Texte affiché pour le lien site web",
      "default": "www.unclevapcbd.com"
    }
  ]
}
{% endschema %}
