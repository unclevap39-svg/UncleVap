{%- unless template.name == 'password' -%}
<div class="age-gate" id="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
  <div class="age-gate-modal">

    <div class="age-gate-badge" aria-hidden="true">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="32" r="31" stroke="#2ea82e" stroke-width="2"/>
        <circle cx="32" cy="32" r="31" stroke="#2ea82e" stroke-width="2" stroke-dasharray="4 4" opacity="0.3"/>
        <text x="32" y="38" text-anchor="middle" font-family="Bebas Neue, sans-serif" font-size="24" fill="#2ea82e" letter-spacing="1">18+</text>
      </svg>
    </div>

    <h2 id="age-gate-title" class="age-gate-title">Vérification de l'âge</h2>
    <p class="age-gate-text">
      Ce site propose des produits à base de CBD réservés aux personnes majeures.<br>
      Confirmez-vous avoir <strong>18 ans ou plus</strong> ?
    </p>

    <div class="age-gate-actions">
      <button class="age-gate-btn age-gate-btn--yes" id="age-gate-yes">
        Oui, j'ai 18 ans ou plus
      </button>
      <a href="https://www.google.com" class="age-gate-btn age-gate-btn--no">
        Non, j'ai moins de 18 ans
      </a>
    </div>

    <p class="age-gate-legal">
      En confirmant, vous attestez sur l'honneur être majeur(e) et acceptez nos
      <a href="{{ routes.root_url }}policies/terms-of-service">conditions d'utilisation</a>.
    </p>
  </div>
</div>

<script>
(function () {
  var gate = document.getElementById('age-gate');
  if (!gate) return;

  if (localStorage.getItem('uv-age-ok') === '1') {
    gate.setAttribute('hidden', '');
    return;
  }

  document.body.classList.add('age-gate-open');

  document.getElementById('age-gate-yes').addEventListener('click', function () {
    localStorage.setItem('uv-age-ok', '1');
    gate.classList.add('age-gate--out');
    document.body.classList.remove('age-gate-open');
    setTimeout(function () { gate.setAttribute('hidden', ''); }, 350);
  });
}());
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Vérification d'âge",
  "settings": []
}
{% endschema %}
