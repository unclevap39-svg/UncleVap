<section class="contact-page" aria-label="Nous contacter">

  <div class="contact-inner">

    <!-- Left: info -->
    <div class="contact-info">
      <p class="contact-eyebrow">{{ section.settings.eyebrow | default: 'Une question ?' }}</p>
      <h1 class="contact-title">{{ section.settings.title | default: 'Contactez-nous' }}</h1>
      <p class="contact-subtitle">{{ section.settings.subtitle | default: "Notre équipe vous répond sous 24h. N'hésitez pas à nous écrire pour toute demande." }}</p>

      <ul class="contact-details">
        {%- if section.settings.email != blank -%}
          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </span>
            <a href="mailto:{{ section.settings.email }}" class="contact-detail-value">{{ section.settings.email }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.07 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <a href="tel:{{ section.settings.phone }}" class="contact-detail-value">{{ section.settings.phone }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span class="contact-detail-value">{{ section.settings.address }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>

    <!-- Right: form -->
    <div class="contact-form-wrap">
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div class="contact-success" role="alert">
            <div class="contact-success-icon" aria-hidden="true">✓</div>
            <h2 class="contact-success-title">Message envoyé !</h2>
            <p class="contact-success-msg">Merci de nous avoir contactés. Nous vous répondrons dans les plus brefs délais.</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="contact-form-errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="contact-form">

            <div class="contact-form-row contact-form-row--2col">
              <div class="contact-field">
                <label for="contact-name" class="contact-label">Nom <span aria-hidden="true">*</span></label>
                <input
                  type="text"
                  id="contact-name"
                  name="contact[name]"
                  class="contact-input"
                  placeholder="Votre nom"
                  value="{{ form.name }}"
                  required
                  autocomplete="name"
                >
              </div>
              <div class="contact-field">
                <label for="contact-email" class="contact-label">E-mail <span aria-hidden="true">*</span></label>
                <input
                  type="email"
                  id="contact-email"
                  name="contact[email]"
                  class="contact-input"
                  placeholder="Votre e-mail"
                  value="{{ form.email }}"
                  required
                  autocomplete="email"
                >
              </div>
            </div>

            <div class="contact-field">
              <label for="contact-phone" class="contact-label">Téléphone</label>
              <input
                type="tel"
                id="contact-phone"
                name="contact[phone]"
                class="contact-input"
                placeholder="Votre numéro (optionnel)"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>

            <div class="contact-field">
              <label for="contact-subject" class="contact-label">Sujet</label>
              <select id="contact-subject" name="contact[subject]" class="contact-input contact-select">
                <option value="">Choisir un sujet…</option>
                <option value="Commande">Ma commande</option>
                <option value="Produit">Question produit</option>
                <option value="Livraison">Livraison</option>
                <option value="Retour">Retour / remboursement</option>
                <option value="Partenariat">Partenariat</option>
                <option value="Autre">Autre</option>
              </select>
            </div>

            <div class="contact-field">
              <label for="contact-body" class="contact-label">Message <span aria-hidden="true">*</span></label>
              <textarea
                id="contact-body"
                name="contact[body]"
                class="contact-input contact-textarea"
                placeholder="Votre message…"
                rows="6"
                required
              >{{ form.body }}</textarea>
            </div>

            <button type="submit" class="contact-submit">
              Envoyer le message
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>

          </div>
        {%- endif -%}
      {% endform %}
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Page Contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Étiquette au-dessus du titre",
      "default": "Une question ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Contactez-nous"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Texte d'introduction",
      "default": "Notre équipe vous répond sous 24h. N'hésitez pas à nous écrire pour toute demande."
    },
    {
      "type": "header",
      "content": "Coordonnées"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Adresse e-mail"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adresse"
    }
  ]
}
{% endschema %}
