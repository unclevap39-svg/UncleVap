{%- assign current_variant   = product.selected_or_first_available_variant -%}
{%- assign mf_cosmic_sub     = product.metafields.custom.cosmic_subtitle -%}
{%- assign mf_prod_tags      = product.metafields.custom.product_tags -%}
{%- assign mf_badge_label    = product.metafields.custom.badge_label -%}
{%- assign mf_badge_emoji    = product.metafields.custom.badge_emoji -%}
{%- assign mf_review_rating  = product.metafields.custom.review_rating -%}
{%- assign mf_review_count   = product.metafields.custom.review_count -%}

<section class="product-page" aria-label="{{ product.title | escape }}">
  <div class="product-page-inner">

    <!-- ── GALERIE ── -->
    <div class="product-gallery">
      <div class="product-gallery-main">

        {%- if mf_badge_label != blank or mf_badge_emoji != blank -%}
          <div class="product-cat-badge">
            {%- if mf_badge_emoji != blank -%}<span class="product-cat-badge-emoji">{{ mf_badge_emoji }}</span>{%- endif -%}
            {%- if mf_badge_label != blank -%}<span>{{ mf_badge_label }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if product.featured_image -%}
          <img
            id="product-main-img"
            src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="800" height="800" loading="eager">
        {%- else -%}
          <div class="product-img-placeholder">
            <svg viewBox="0 0 80 80" fill="none" width="80" height="80">
              <path d="M40 8C40 8 20 20 18 38C16 56 30 68 40 68C50 68 64 56 62 38C60 20 40 8 40 8Z" fill="#2ea82e" opacity="0.4"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-thumbs">
          {%- for image in product.images limit: 6 -%}
            <button class="product-thumb-btn{% if forloop.first %} active{% endif %}"
              data-src="{{ image | image_url: width: 800 }}"
              type="button" aria-label="Image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | escape }}" width="80" height="80" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- ── INFOS PRODUIT ── -->
    <div class="product-info">

      <!-- Note / Avis -->
      {%- if section.settings.show_rating -%}
        <div class="product-rating-row">
          <span class="product-stars" aria-hidden="true">★★★★★</span>
          <span class="product-rating-count">
            {%- assign rc = mf_review_count | default: section.settings.review_count | default: 128 -%}
            ({{ rc }} {{ section.settings.rating_label | default: 'avis vérifiés' }})
          </span>
        </div>
      {%- endif -%}

      <!-- Titre + Sous-titre cosmique -->
      <div class="product-title-block">
        <h1 class="product-title">{{ product.title }}</h1>
        {%- if mf_cosmic_sub != blank -%}
          <p class="product-cosmic-sub">— <em>{{ mf_cosmic_sub }}</em></p>
        {%- endif -%}
      </div>

      <!-- Tags produit (SATIVA DOMINANT • INDOOR HYDRO …) -->
      {%- if mf_prod_tags != blank -%}
        <p class="product-cosmos-tags">
          {%- assign tags_arr = mf_prod_tags | split: ',' -%}
          {%- for t in tags_arr -%}
            <span>{{ t | strip | upcase }}</span>{% unless forloop.last %}<span class="cosmos-tag-sep"> • </span>{% endunless %}
          {%- endfor -%}
        </p>
      {%- elsif product.type != blank -%}
        <p class="product-cosmos-tags"><span>{{ product.type | upcase }}</span></p>
      {%- endif -%}

      <!-- Prix -->
      <div class="product-price-row" id="product-price-wrap">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="price-compare" id="product-price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="price-main price-main--sale" id="product-price">{{ current_variant.price | money }}</span>
          <span class="price-badge-saved" id="price-saved-badge">-{{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price | round }}%</span>
        {%- else -%}
          <span class="price-compare" id="product-price-compare" style="display:none;"></span>
          <span class="price-main" id="product-price">{{ current_variant.price | money }}</span>
          <span class="price-badge-saved" id="price-saved-badge" style="display:none;"></span>
        {%- endif -%}
        <span class="price-ttc-label">TTC</span>
      </div>

      <!-- Formulaire -->
      {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
        <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        {%- unless product.has_only_default_variant -%}
          {%- comment %} Vraies variantes Shopify {%- endcomment %}
          {%- for option in product.options_with_values -%}
            <div class="variant-group">
              <p class="variant-label">Sélectionnez le {{ option.name }} <span class="variant-selected-val" id="opt-val-{{ forloop.index0 }}">— {{ option.selected_value }}</span></p>
              <div class="variant-grid" data-opt="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <button type="button"
                    class="variant-pill{% if option.selected_value == value %} is-active{% endif %}"
                    data-val="{{ value | escape }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment %} Produit à variante unique : sélecteur de poids cosmétique depuis les settings {%- endcomment %}
          {%- assign fallback_weights = section.settings.fallback_weights -%}
          {%- if fallback_weights != blank -%}
            {%- assign fw_arr = fallback_weights | split: ',' -%}
            <div class="variant-group">
              <p class="variant-label">Sélectionnez le poids <span class="variant-selected-val" id="fw-selected">— {{ fw_arr[0] | strip }}</span></p>
              <div class="variant-pills-fallback">
                {%- for w in fw_arr -%}
                  <button type="button"
                    class="variant-pill{% if forloop.first %} is-active{% endif %}"
                    data-fw="{{ w | strip | escape }}">
                    {{ w | strip }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endunless -%}

        <!-- Sélecteur de quantité si activé dans les settings -->
        {%- if section.settings.show_qty -%}
          <div class="qty-group">
            <p class="variant-label">Quantité</p>
            <div class="qty-stepper">
              <button type="button" class="qty-btn" id="qty-minus" aria-label="Diminuer">−</button>
              <input type="number" name="quantity" id="qty-input" value="1" min="1" class="qty-input">
              <button type="button" class="qty-btn" id="qty-plus" aria-label="Augmenter">+</button>
            </div>
          </div>
        {%- endif -%}

        <button type="submit" class="btn-atc btn-atc--v2" id="btn-atc"
          {% unless current_variant.available %}disabled{% endunless %}>
          <span id="atc-label">
            {%- if current_variant.available -%}
              {{ section.settings.atc_text_available | default: 'Ajouter au panier' }}
            {%- else -%}
              {{ section.settings.atc_text_unavailable | default: 'Rupture de stock' }}
            {%- endif -%}
          </span>
        </button>

        <!-- Trust badges inline -->
        {%- if section.settings.show_trust_badges -%}
          <div class="product-hero-trust">
            {%- if section.settings.trust_badge_1 != blank -%}
              <span class="hero-trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {{ section.settings.trust_badge_1 }}
              </span>
            {%- endif -%}
            {%- if section.settings.trust_badge_2 != blank -%}
              <span class="hero-trust-sep">|</span>
              <span class="hero-trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                {{ section.settings.trust_badge_2 }}
              </span>
            {%- endif -%}
            {%- if section.settings.trust_badge_3 != blank -%}
              <span class="hero-trust-sep">|</span>
              <span class="hero-trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ section.settings.trust_badge_3 }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Icônes paiement -->
        {%- if section.settings.show_payment_icons -%}
          <div class="product-payment-row">
            {%- if section.settings.payment_label != blank -%}
              <span class="product-payment-label">{{ section.settings.payment_label }}</span>
            {%- endif -%}
            <div class="product-payment-icons">
              {%- if section.settings.show_visa -%}
                <svg class="pay-icon" viewBox="0 0 48 30" xmlns="http://www.w3.org/2000/svg" aria-label="Visa" role="img">
                  <rect width="48" height="30" rx="4" fill="#1a1f71"/>
                  <path d="M20.5 20H17.8l1.7-10H22l-1.5 10zm-6.5 0l-2.6-6.9-.3 1.5-1 5.4H8l2.6-10h2.9l3.2 8.2.3-8.2H19l-1.6 10h-3.4zm22.2 0h-2.7l-.3-1.3h-3.3l-.5 1.3h-2.8l4-10h3l2.6 10zm-5.6-3.3h2.1l-.8-4-1.3 4zM39 15.3c0-.7-.5-1.2-1.6-1.7-1.1-.5-1.1-.5-1.1-.8 0-.3.3-.5.9-.5.9 0 1.5.2 2 .4l.3-1.7c-.5-.2-1.3-.4-2.3-.4-2.5 0-4.2 1.3-4.2 3.1 0 1.4 1.3 2.1 2.2 2.6.9.5 1.3.8 1.3 1.2 0 .7-.8 1-1.5 1-1.1 0-1.9-.3-2.5-.5l-.3 1.8c.6.3 1.6.5 2.7.5 2.7.1 4.2-1.3 4.1-3z" fill="#fff"/>
                </svg>
              {%- endif -%}
              {%- if section.settings.show_mastercard -%}
                <svg class="pay-icon" viewBox="0 0 48 30" xmlns="http://www.w3.org/2000/svg" aria-label="Mastercard" role="img">
                  <rect width="48" height="30" rx="4" fill="#252525"/>
                  <circle cx="19" cy="15" r="8" fill="#eb001b"/>
                  <circle cx="29" cy="15" r="8" fill="#f79e1b"/>
                  <path d="M24 9.3a8 8 0 0 1 0 11.4A8 8 0 0 1 24 9.3z" fill="#ff5f00"/>
                </svg>
              {%- endif -%}
              {%- if section.settings.show_cb -%}
                <svg class="pay-icon" viewBox="0 0 48 30" xmlns="http://www.w3.org/2000/svg" aria-label="CB" role="img">
                  <rect width="48" height="30" rx="4" fill="#0054a6"/>
                  <text x="8" y="21" font-family="Arial,sans-serif" font-weight="700" font-size="13" fill="#fff" letter-spacing="1">CB</text>
                </svg>
              {%- endif -%}
              {%- if section.settings.show_amex -%}
                <svg class="pay-icon" viewBox="0 0 48 30" xmlns="http://www.w3.org/2000/svg" aria-label="American Express" role="img">
                  <rect width="48" height="30" rx="4" fill="#016FD0"/>
                  <text x="5" y="20" font-family="Arial,sans-serif" font-weight="700" font-size="9" fill="#fff" letter-spacing="0.3">AMERICAN</text>
                  <text x="5" y="27" font-family="Arial,sans-serif" font-weight="700" font-size="9" fill="#fff" letter-spacing="0.3">EXPRESS</text>
                </svg>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      {%- endform -%}

    </div>
  </div>
</section>

<!-- ── Sticky ATC ── -->
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  <div class="sticky-atc-inner">
    <div class="sticky-atc-product">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}" width="40" height="40" loading="lazy" class="sticky-atc-img">
      {%- endif -%}
      <div class="sticky-atc-info">
        <span class="sticky-atc-name">{{ product.title }}</span>
        <span class="sticky-atc-price" id="sticky-price">{{ current_variant.price | money }}</span>
      </div>
    </div>
    <button type="button" class="sticky-atc-btn" id="sticky-atc-btn"
      {% unless current_variant.available %}disabled{% endunless %}>
      Ajouter au panier
    </button>
  </div>
</div>

<script>
(function(){
  var variants = {{ product.variants | json }};
  var curId    = {{ current_variant.id | json }};
  var selOpts  = [{% for opt in product.options_with_values %}{{ opt.selected_value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}];

  function money(c){ return (c/100).toLocaleString('fr-FR',{minimumFractionDigits:2,maximumFractionDigits:2})+'\u00a0€'; }
  function findVariant(){ return variants.find(function(v){ return v.options.every(function(o,i){return o===selOpts[i];}); }); }

  function applyVariant(v){
    if(!v) return;
    document.getElementById('variant-id').value = v.id;
    curId = v.id;
    var pe=document.getElementById('product-price'), ce=document.getElementById('product-price-compare'), se=document.getElementById('price-saved-badge');
    if(pe) pe.textContent=money(v.price);
    if(ce){ if(v.compare_at_price&&v.compare_at_price>v.price){ce.textContent=money(v.compare_at_price);ce.style.display='';}else{ce.textContent='';ce.style.display='none';} }
    if(se){ if(v.compare_at_price&&v.compare_at_price>v.price){se.textContent='-'+Math.round((v.compare_at_price-v.price)*100/v.compare_at_price)+'%';se.style.display='';}else{se.style.display='none';} }
    var btn=document.getElementById('btn-atc'),lbl=document.getElementById('atc-label');
    if(btn){btn.disabled=!v.available;}
    if(lbl){ lbl.textContent=v.available?'Ajouter au panier':'Rupture de stock'; }
    var sp=document.getElementById('sticky-price'); if(sp) sp.textContent=money(v.price);
    var sb=document.getElementById('sticky-atc-btn'); if(sb) sb.disabled=!v.available;
    if(v.featured_image){var im=document.getElementById('product-main-img');if(im)im.src=v.featured_image.src;}
    var url=new URL(window.location.href); url.searchParams.set('variant',v.id); history.replaceState({},'',url.toString());
    syncPills();
  }

  function syncPills(){
    document.querySelectorAll('.variant-grid').forEach(function(g){
      var i=parseInt(g.dataset.opt,10);
      g.querySelectorAll('.variant-pill').forEach(function(b){ b.classList.toggle('is-active',b.dataset.val===selOpts[i]); });
    });
  }

  document.querySelectorAll('.variant-grid').forEach(function(g){
    var i=parseInt(g.dataset.opt,10);
    g.querySelectorAll('.variant-pill').forEach(function(b){
      b.addEventListener('click',function(){
        selOpts[i]=b.dataset.val;
        var vd=document.getElementById('opt-val-'+i); if(vd) vd.textContent='— '+b.dataset.val;
        applyVariant(findVariant());
      });
    });
  });

  var qi=document.getElementById('qty-input');
  if(qi){
    var qm=document.getElementById('qty-minus'),qp=document.getElementById('qty-plus');
    if(qm) qm.addEventListener('click',function(){var n=parseInt(qi.value,10);if(n>1)qi.value=n-1;});
    if(qp) qp.addEventListener('click',function(){qi.value=parseInt(qi.value,10)+1;});
  }

  document.querySelectorAll('.product-thumb-btn').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.product-thumb-btn').forEach(function(x){x.classList.remove('active');});
      b.classList.add('active');
      var im=document.getElementById('product-main-img'); if(im) im.src=b.dataset.src;
    });
  });

  // Pills de secours (produit variante unique)
  document.querySelectorAll('.variant-pills-fallback .variant-pill').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.variant-pills-fallback .variant-pill').forEach(function(x){x.classList.remove('is-active');});
      b.classList.add('is-active');
      var sel=document.getElementById('fw-selected'); if(sel) sel.textContent='— '+b.dataset.fw;
    });
  });

  var sbar=document.getElementById('sticky-atc');
  var matc=document.getElementById('btn-atc');
  if(sbar&&matc&&'IntersectionObserver' in window){
    new IntersectionObserver(function(e){e.forEach(function(en){sbar.classList.toggle('sticky-atc--visible',!en.isIntersecting);sbar.setAttribute('aria-hidden',String(en.isIntersecting));});},{threshold:0}).observe(matc);
  }
  var sb2=document.getElementById('sticky-atc-btn');
  if(sb2) sb2.addEventListener('click',function(){var f=document.getElementById('product-form');if(f){if(f.requestSubmit)f.requestSubmit();else f.submit();}});
}());
</script>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    {
      "type": "header",
      "content": "⭐ Avis & note"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Afficher la note étoiles",
      "default": true
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Nombre d'avis (si pas de metafield)",
      "default": 128
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Texte à côté des étoiles",
      "default": "avis vérifiés",
      "info": "Ex : 'avis vérifiés' → '(128 avis vérifiés)'"
    },
    {
      "type": "header",
      "content": "📦 Variantes & quantité"
    },
    {
      "type": "text",
      "id": "fallback_weights",
      "label": "Poids de secours (produit sans variantes)",
      "info": "Séparés par des virgules. Ex : 1g,3g,5g,10g,20g",
      "default": "1g,3g,5g,10g,20g"
    },
    {
      "type": "text",
      "id": "variant_selector_label",
      "label": "Texte du sélecteur de poids (secours)",
      "default": "Sélectionnez le poids"
    },
    {
      "type": "checkbox",
      "id": "show_qty",
      "label": "Afficher le sélecteur de quantité",
      "default": false
    },
    {
      "type": "header",
      "content": "🛒 Bouton Ajouter au panier"
    },
    {
      "type": "text",
      "id": "atc_text_available",
      "label": "Texte bouton (disponible)",
      "default": "Ajouter au panier"
    },
    {
      "type": "text",
      "id": "atc_text_unavailable",
      "label": "Texte bouton (rupture)",
      "default": "Rupture de stock"
    },
    {
      "type": "header",
      "content": "✅ Badges de confiance"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Afficher les badges de confiance",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Badge confiance 1",
      "default": "100% Bio & Pur"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Badge confiance 2",
      "default": "Expédition 24h"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Badge confiance 3 (optionnel)",
      "default": ""
    },
    {
      "type": "header",
      "content": "💳 Paiement sécurisé"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Afficher les icônes paiement",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Texte paiement sécurisé",
      "default": "🔒 Paiement sécurisé"
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Afficher Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Afficher Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cb",
      "label": "Afficher CB",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Afficher American Express",
      "default": true
    },
    {
      "type": "header",
      "content": "🖼️ Galerie images"
    },
    {
      "type": "range",
      "id": "gallery_images_limit",
      "label": "Nombre max de vignettes",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "📐 Layout & style"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition (desktop)",
      "options": [
        { "value": "image-left",  "label": "Image à gauche" },
        { "value": "image-right", "label": "Image à droite" }
      ],
      "default": "image-left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement haut",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement bas",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
