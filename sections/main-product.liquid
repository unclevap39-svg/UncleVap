{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product-page" aria-label="{{ product.title | escape }}">
  <div class="product-page-inner">

    <!-- ═══ GALERIE ═══ -->
    <div class="product-gallery">
      <div class="product-gallery-main">
        {%- if product.images.size > 0 -%}
          <img
            id="product-main-img"
            src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="800"
            height="800"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <div class="product-img-placeholder">
            <svg viewBox="0 0 80 80" fill="none" width="80" height="80">
              <path d="M40 8C40 8 20 20 18 38C16 56 30 68 40 68C50 68 64 56 62 38C60 20 40 8 40 8Z" fill="#2ea82e" opacity="0.4"/>
              <path d="M40 8 L40 68" stroke="#1d7a1d" stroke-width="1.5" opacity="0.5"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-thumbs" aria-label="Images du produit">
          {%- for image in product.images limit: 6 -%}
            <button
              class="product-thumb-btn{% if forloop.first %} active{% endif %}"
              data-src="{{ image | image_url: width: 800 }}"
              aria-label="Image {{ forloop.index }}"
              type="button"
            >
              <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | escape }}" width="80" height="80" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- ═══ INFOS PRODUIT ═══ -->
    <div class="product-info">

      {%- if product.type != blank -%}
        <p class="product-type-tag">{{ product.type }}</p>
      {%- endif -%}

      <h1 class="product-title">{{ product.title }}</h1>

      <!-- Prix -->
      <div class="product-price-row" id="product-price-wrap">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="price-main price-main--sale" id="product-price">{{ current_variant.price | money }}</span>
          <span class="price-badge-saved">
            -{{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price | round }}%
          </span>
        {%- else -%}
          <span class="price-main" id="product-price">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <!-- ═ SÉLECTEUR GRAMMES / TARIFS DÉGRESSIFS ═ -->
      {%- if section.settings.show_tiers -%}
        <div class="tiers-section">
          <p class="tiers-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            {{ section.settings.tiers_title | default: 'Choisissez votre quantité' }}
          </p>
          <div class="tiers-grid" id="tiers-grid">
            {%- if section.settings.tier1_active and section.settings.tier1_qty != blank -%}
              <button type="button" class="tier-tile" data-match="{{ section.settings.tier1_match | downcase }}" data-opt-index="{{ section.settings.tier1_opt_index | default: 0 }}">
                {%- if section.settings.tier1_badge != blank -%}<span class="tier-badge">{{ section.settings.tier1_badge }}</span>{%- endif -%}
                <span class="tier-qty">{{ section.settings.tier1_qty }}</span>
                <span class="tier-total">{{ section.settings.tier1_total }}€</span>
                <span class="tier-per-g">{{ section.settings.tier1_per_g }}€/g</span>
              </button>
            {%- endif -%}
            {%- if section.settings.tier2_active and section.settings.tier2_qty != blank -%}
              <button type="button" class="tier-tile" data-match="{{ section.settings.tier2_match | downcase }}" data-opt-index="{{ section.settings.tier2_opt_index | default: 0 }}">
                {%- if section.settings.tier2_badge != blank -%}<span class="tier-badge">{{ section.settings.tier2_badge }}</span>{%- endif -%}
                <span class="tier-qty">{{ section.settings.tier2_qty }}</span>
                <span class="tier-total">{{ section.settings.tier2_total }}€</span>
                <span class="tier-per-g">{{ section.settings.tier2_per_g }}€/g</span>
              </button>
            {%- endif -%}
            {%- if section.settings.tier3_active and section.settings.tier3_qty != blank -%}
              <button type="button" class="tier-tile" data-match="{{ section.settings.tier3_match | downcase }}" data-opt-index="{{ section.settings.tier3_opt_index | default: 0 }}">
                {%- if section.settings.tier3_badge != blank -%}<span class="tier-badge">{{ section.settings.tier3_badge }}</span>{%- endif -%}
                <span class="tier-qty">{{ section.settings.tier3_qty }}</span>
                <span class="tier-total">{{ section.settings.tier3_total }}€</span>
                <span class="tier-per-g">{{ section.settings.tier3_per_g }}€/g</span>
              </button>
            {%- endif -%}
            {%- if section.settings.tier4_active and section.settings.tier4_qty != blank -%}
              <button type="button" class="tier-tile" data-match="{{ section.settings.tier4_match | downcase }}" data-opt-index="{{ section.settings.tier4_opt_index | default: 0 }}">
                {%- if section.settings.tier4_badge != blank -%}<span class="tier-badge">{{ section.settings.tier4_badge }}</span>{%- endif -%}
                <span class="tier-qty">{{ section.settings.tier4_qty }}</span>
                <span class="tier-total">{{ section.settings.tier4_total }}€</span>
                <span class="tier-per-g">{{ section.settings.tier4_per_g }}€/g</span>
              </button>
            {%- endif -%}
            {%- if section.settings.tier5_active and section.settings.tier5_qty != blank -%}
              <button type="button" class="tier-tile" data-match="{{ section.settings.tier5_match | downcase }}" data-opt-index="{{ section.settings.tier5_opt_index | default: 0 }}">
                {%- if section.settings.tier5_badge != blank -%}<span class="tier-badge">{{ section.settings.tier5_badge }}</span>{%- endif -%}
                <span class="tier-qty">{{ section.settings.tier5_qty }}</span>
                <span class="tier-total">{{ section.settings.tier5_total }}€</span>
                <span class="tier-per-g">{{ section.settings.tier5_per_g }}€/g</span>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- ═ FORMULAIRE VARIANTS + PANIER ═ -->
      <form
        action="{{ routes.cart_add_url }}"
        method="post"
        id="product-form"
        class="product-form"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="variant-group">
              <p class="variant-label">
                {{ option.name }}
                <span class="variant-selected-val" id="opt-val-{{ forloop.index0 }}">— {{ option.selected_value }}</span>
              </p>
              <div class="variant-btns" data-opt="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="variant-btn{% if option.selected_value == value %} is-active{% endif %}"
                    data-val="{{ value | escape }}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <!-- Quantité -->
        <div class="qty-group">
          <p class="variant-label">Quantité</p>
          <div class="qty-stepper">
            <button type="button" class="qty-btn" id="qty-minus" aria-label="Diminuer">−</button>
            <input type="number" name="quantity" id="qty-input" value="1" min="1" class="qty-input" aria-label="Quantité">
            <button type="button" class="qty-btn" id="qty-plus" aria-label="Augmenter">+</button>
          </div>
        </div>

        <!-- Bouton panier -->
        <button
          type="submit"
          class="btn-atc"
          id="btn-atc"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span id="atc-label">
            {%- if current_variant.available -%}Ajouter au panier{%- else -%}Rupture de stock{%- endif -%}
          </span>
        </button>

      </form>

      <!-- Description -->
      {%- if product.description != blank -%}
        <div class="product-desc rte">{{ product.description }}</div>
      {%- endif -%}

    </div><!-- /product-info -->
  </div><!-- /product-page-inner -->
</section>

<script>
(function () {
  var variants   = {{ product.variants | json }};
  var selOptions = [
    {%- for option in product.options_with_values -%}
      {{ option.selected_value | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  function findVariant() {
    return variants.find(function(v) {
      return v.options.every(function(opt, i) { return opt === selOptions[i]; });
    });
  }

  function money(cents) {
    return (cents / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '\u00a0€';
  }

  function applyVariant(v) {
    if (!v) return;
    document.getElementById('variant-id').value = v.id;
    var priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = money(v.price);
    var btn = document.getElementById('btn-atc');
    var label = document.getElementById('atc-label');
    if (btn && label) {
      btn.disabled = !v.available;
      label.textContent = v.available ? 'Ajouter au panier' : 'Rupture de stock';
    }
    if (v.featured_image) {
      var imgEl = document.getElementById('product-main-img');
      if (imgEl) imgEl.src = v.featured_image.src;
    }
    var url = new URL(window.location.href);
    url.searchParams.set('variant', v.id);
    window.history.replaceState({}, '', url.toString());
  }

  /* ── Boutons variantes classiques ── */
  document.querySelectorAll('.variant-btns').forEach(function(group) {
    var optIdx = parseInt(group.dataset.opt, 10);
    group.querySelectorAll('.variant-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        group.querySelectorAll('.variant-btn').forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        selOptions[optIdx] = btn.dataset.val;
        var valDisplay = document.getElementById('opt-val-' + optIdx);
        if (valDisplay) valDisplay.textContent = '— ' + btn.dataset.val;
        applyVariant(findVariant());
        syncTiersToVariant();
      });
    });
  });

  /* ── Sélecteur de paliers dégressifs ── */
  function syncTiersToVariant() {
    var tiles = document.querySelectorAll('.tier-tile');
    if (!tiles.length) return;
    var optStr = selOptions.join(' ').toLowerCase();
    tiles.forEach(function(tile) {
      var match = (tile.dataset.match || '').toLowerCase();
      tile.classList.toggle('is-active', match && optStr.indexOf(match) !== -1);
    });
  }

  document.querySelectorAll('.tier-tile').forEach(function(tile) {
    tile.addEventListener('click', function() {
      var matchVal = tile.dataset.match;
      var optIdx   = parseInt(tile.dataset.optIndex || '0', 10);
      /* Trouver le bouton variante correspondant et le déclencher */
      var targetBtn = null;
      document.querySelectorAll('.variant-btns[data-opt="' + optIdx + '"] .variant-btn').forEach(function(btn) {
        if (btn.dataset.val.toLowerCase() === matchVal) targetBtn = btn;
      });
      if (targetBtn) {
        targetBtn.click();
      } else {
        /* Fallback : sélection directe si pas de boutons variantes visibles */
        selOptions[optIdx] = matchVal;
        applyVariant(findVariant());
        document.querySelectorAll('.tier-tile').forEach(function(t) { t.classList.remove('is-active'); });
        tile.classList.add('is-active');
      }
    });
  });

  /* Synchronisation initiale des paliers */
  syncTiersToVariant();

  /* ── Quantité ── */
  var qtyInput = document.getElementById('qty-input');
  if (qtyInput) {
    document.getElementById('qty-minus').addEventListener('click', function() {
      var n = parseInt(qtyInput.value, 10);
      if (n > 1) qtyInput.value = n - 1;
    });
    document.getElementById('qty-plus').addEventListener('click', function() {
      qtyInput.value = parseInt(qtyInput.value, 10) + 1;
    });
  }

  /* ── Galerie miniatures ── */
  document.querySelectorAll('.product-thumb-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.product-thumb-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var imgEl = document.getElementById('product-main-img');
      if (imgEl) imgEl.src = btn.dataset.src;
    });
  });

}());
</script>

