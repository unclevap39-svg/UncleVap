{%- if section.settings.enabled -%}
<div class="product-urgency">
  <div class="urgency-inner">

    {%- if section.settings.badge_text != blank -%}
      <div class="urgency-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        {{ section.settings.badge_text }}
      </div>
    {%- endif -%}

    {%- if section.settings.viewers_text != blank -%}
      <div class="urgency-row">
        <span class="urgency-dot"></span>
        <span class="urgency-text">{{ section.settings.viewers_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.show_stock_bar -%}
      <div class="urgency-stock">
        <div class="urgency-stock-label">
          <span>{{ section.settings.stock_label | default: 'Stock disponible' }}</span>
          <span>{{ section.settings.stock_remaining | default: '12' }} restants</span>
        </div>
        <div class="urgency-bar-track">
          <div class="urgency-bar-fill" style="width: {{ section.settings.stock_percent | default: 20 }}%"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.delivery_text != blank -%}
      <div class="urgency-row">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span class="urgency-text">{{ section.settings.delivery_text }}</span>
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Urgence / Scarcité",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Afficher cette section",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge offre limitée",
      "default": "Offre limitée — Stock en cours d'épuisement"
    },
    {
      "type": "text",
      "id": "viewers_text",
      "label": "Texte visiteurs en ligne",
      "default": "<strong>23 personnes</strong> consultent ce produit en ce moment"
    },
    {
      "type": "header",
      "content": "Barre de stock"
    },
    {
      "type": "checkbox",
      "id": "show_stock_bar",
      "label": "Afficher la barre de stock",
      "default": true
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "Libellé de la barre",
      "default": "Stock disponible"
    },
    {
      "type": "text",
      "id": "stock_remaining",
      "label": "Nombre restant affiché",
      "default": "12"
    },
    {
      "type": "range",
      "id": "stock_percent",
      "label": "Remplissage de la barre (%)",
      "min": 5,
      "max": 80,
      "step": 5,
      "default": 20
    },
    {
      "type": "header",
      "content": "Livraison"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Texte livraison express",
      "default": "Commandez avant 14h — Expédition aujourd'hui"
    }
  ]
}
{% endschema %}
