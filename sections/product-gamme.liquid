{%- liquid
  assign title   = section.settings.title   | default: 'Guide de Dégustation'
  assign step1_t = section.settings.step1_title
  assign step1_d = section.settings.step1_desc
  assign step2_t = section.settings.step2_title
  assign step2_d = section.settings.step2_desc
  assign step3_t = section.settings.step3_title
  assign step3_d = section.settings.step3_desc
  assign quote   = section.settings.quote
-%}

<section class="guide-degustation" id="guide-{{ section.id }}">
  <div class="guide-inner">

    <!-- Colonne gauche : titre + étapes numérotées -->
    <div class="guide-left">
      <h2 class="guide-title">
        {%- assign title_parts = title | split: ' de ' -%}
        {%- if title_parts.size > 1 -%}
          {{ title_parts[0] }} de <span class="guide-title-accent">{{ title_parts[1] }}</span>
        {%- else -%}
          {{ title }}
        {%- endif -%}
      </h2>

      <div class="guide-steps">

        {%- if step1_t != blank -%}
          <div class="guide-step">
            <span class="guide-step-num">01</span>
            <div class="guide-step-content">
              <h3 class="guide-step-title">{{ step1_t }}</h3>
              {%- if step1_d != blank -%}<p class="guide-step-desc">{{ step1_d }}</p>{%- endif -%}
            </div>
          </div>
        {%- else -%}
          <div class="guide-step">
            <span class="guide-step-num">01</span>
            <div class="guide-step-content">
              <h3 class="guide-step-title">Infusion Stellaire</h3>
              <p class="guide-step-desc">Laissez infuser 10 min dans une eau à 85°C avec un corps gras (lait, coco) pour activer les molécules.</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="guide-step-num">02</span>
            <div class="guide-step-content">
              <h3 class="guide-step-title">Vaporisation</h3>
              <p class="guide-step-desc">Température idéale : 180°C. Préserve les terpènes et évite la combustion toxique.</p>
            </div>
          </div>
        {%- endif -%}

        {%- if step2_t != blank -%}
          <div class="guide-step">
            <span class="guide-step-num">02</span>
            <div class="guide-step-content">
              <h3 class="guide-step-title">{{ step2_t }}</h3>
              {%- if step2_d != blank -%}<p class="guide-step-desc">{{ step2_d }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if step3_t != blank -%}
          <div class="guide-step">
            <span class="guide-step-num">03</span>
            <div class="guide-step-content">
              <h3 class="guide-step-title">{{ step3_t }}</h3>
              {%- if step3_d != blank -%}<p class="guide-step-desc">{{ step3_d }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>

    <!-- Colonne droite : image produit avec citation -->
    <div class="guide-right">
      <div class="guide-img-wrap">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 700 }}"
               alt="{{ product.title | escape }}"
               width="700" height="700"
               loading="lazy">
        {%- else -%}
          <div class="guide-img-placeholder"></div>
        {%- endif -%}

        <div class="guide-quote-overlay">
          <p class="guide-quote-text">
            "{{ quote | default: 'Un nuage de pureté dans l\'immensité du vide.' }}"
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Guide de Dégustation",
  "settings": [
    { "type": "text",  "id": "title",       "label": "Titre",                  "default": "Guide de Dégustation" },
    { "type": "text",  "id": "step1_title", "label": "Étape 1 — Titre" },
    { "type": "textarea", "id": "step1_desc","label": "Étape 1 — Description" },
    { "type": "text",  "id": "step2_title", "label": "Étape 2 — Titre" },
    { "type": "textarea", "id": "step2_desc","label": "Étape 2 — Description" },
    { "type": "text",  "id": "step3_title", "label": "Étape 3 — Titre" },
    { "type": "textarea", "id": "step3_desc","label": "Étape 3 — Description" },
    { "type": "text",  "id": "quote",       "label": "Citation (droite)" }
  ],
  "presets": [{ "name": "Guide de Dégustation" }]
}
{% endschema %}
