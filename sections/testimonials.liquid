{% schema %}
{
  "name": "Avis Clients",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "CE QUE DIT LA GALAXIE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Des milliers de voyageurs nous font confiance."
    }
  ],
  "presets": [
    { "name": "Avis Clients" }
  ]
}
{% endschema %}
