<section class="testimonials" id="testimonials-{{ section.id }}">
  <div class="testimonials-inner">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title | default: 'CE QUE DIT LA GALAXIE' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'Des milliers de voyageurs nous font confiance.' }}</p>
    </div>

    {%- comment %} Carousel infini : les cartes sont dupliquées pour un défilement sans fin {%- endcomment %}
    <div class="testimonials-track-wrap" aria-label="Carrousel d'avis clients">
      <div class="testimonials-track">

        {%- comment %} === Série 1 (originale) === {%- endcomment %}
        <div class="testimonial-card">
          <div class="testimonial-stars"><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span></div>
          <p class="testimonial-text">"Des fleurs d'une qualité exceptionnelle. Je ne commande plus nulle part ailleurs, livraison rapide et emballage soigné."</p>
          <div class="testimonial-author"><span class="testimonial-name">Mathieu R.</span><span class="testimonial-location">— Lyon</span></div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-stars"><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span><span class="star star--on">★</span></div>
          <p class="testimonial-text">"Uncle Vap c'est une autre dimension. Les CBD étaient frais, odorants et vraiment efficaces pour me détendre après le travail."</p>
          <div class="testimonial-author"><span class="testimonial-name">Camille T.</span><span class="testimonial-location">— Paris</span></div>
        </div>

        <div class="testimonial-card">
